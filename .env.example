# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables for production.
# Find them in Supabase → Project Settings → API (or "Connect" → App Frameworks).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public URL of the deployed app (used for auth e-mail redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional (recommended with Google sign-in): your Google OAuth *Web client ID* (public, NOT the secret).
# When set, Google's sign-in screen shows THIS site's address instead of <project>.supabase.co.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: Google Search Console verification code (content of the google-site-verification
# meta tag). Needed only for Google OAuth brand verification. Example: abc123XYZ...
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional: contact email shown on the /privacy page
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Security (recommended for production) ---
# Server-only secret for rate limiting (NO "NEXT_PUBLIC_" prefix). Any long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=

# Cloudflare Turnstile CAPTCHA site key (public). Pair it with the SECRET key in
# Supabase -> Authentication -> Attack Protection -> CAPTCHA (never put the secret here).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
